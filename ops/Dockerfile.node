# Image for apps/api, apps/reporting and the one-off migrate/seed jobs.
# The services run their TypeScript directly under tsx (as in dev), so the
# full workspace install is kept. Build context is the repo root.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY packages packages
COPY apps/api apps/api
COPY apps/reporting apps/reporting
COPY db db
COPY scripts scripts

RUN mkdir -p /app/data/kyc && chown -R node:node /app/data
USER node

EXPOSE 3000
CMD ["npx", "tsx", "apps/api/src/index.ts"]
