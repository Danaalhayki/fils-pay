# Copy to ops/.env (gitignored) and fill in. Nothing secret belongs in git.
# Every value here is optional on a laptop; on a hosted box set
# NODE_ENV=production and every secret below, or the api refuses to boot.

NODE_ENV=development

# Database password for the bundled Postgres (only reachable on loopback).
POSTGRES_PASSWORD=filspay_dev_password

# Shared bearer token between apps/api and apps/settlement's internal API.
# Generate: openssl rand -hex 32
SETTLEMENT_INTERNAL_TOKEN=

# AES-256-GCM key for webhook signing secrets at rest: base64 of 32 bytes.
# Generate: openssl rand -base64 32
# Never change it once endpoints exist; their secrets become unreadable.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Issued by the acquirer for callback signatures. The sandbox secret that used
# to be committed in ops/.env.docker is in git history: have it rotated.
ACQUIRER_CALLBACK_SIGNING_SECRET=

# There is no email/SMS OTP provider yet: in production the code is neither
# logged nor returned, so nobody can log in. For a hosted DEMO only, set this
# to true to return the code in the login response (the login pages show it).
# That reduces login to password-only; never set it with real merchants.
OTP_DEV_EXPOSE=

# Public URLs (what the browser sees). Behind an https terminator, use https
# here and leave COOKIE_SECURE empty: production defaults it to true.
PUBLIC_WEB_URL=http://localhost:8080
COOKIE_SECURE=

# Host ports. Loopback by default; the https terminator (DEPLOY.md) is what
# faces the internet. Only use 0.0.0.0:PORT if you really mean it.
WEB_PORT=127.0.0.1:8080
ADMIN_PORT=127.0.0.1:8081

# Reverse proxies in front of the api: nginx = 1, nginx behind Caddy = 2.
TRUST_PROXY_HOPS=1
API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
