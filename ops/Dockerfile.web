# Builds apps/web (merchant dashboard + checkout) and apps/admin (ops
# console) and serves both from nginx, each proxying /v1 to the api so the
# browser only ever talks to its own origin (the api sends no CORS headers).
# Build context is the repo root.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --no-audit --no-fund
COPY packages packages
COPY apps/web apps/web
COPY apps/admin apps/admin
# Where the admin console's "view as merchant" link opens the dashboard.
ARG PUBLIC_WEB_URL=http://localhost:8080
ENV VITE_WEB_BASE_URL=${PUBLIC_WEB_URL}
RUN npm run build -w @filspay/web && npm run build -w @filspay/admin

FROM nginx:1.27-alpine
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/web
COPY --from=build /app/apps/admin/dist /usr/share/nginx/admin
EXPOSE 8080 8081
